<style>
:root {
  --bg-primary: #0A0A0A;
  --bg-secondary: #0A0A0A;
  --bg-card: #0A0A0A;
  --border-color: #1a2740;
  --text-primary: #FFFFFF;
  --text-secondary: #B0B0B0;
  --text-muted: #888888;
  --accent-gold: #F7931A;
  --accent-gold-glow: rgba(247, 147, 26, 0.10);
  --accent-cyan: #22d3ee;
  --gradient-gold: linear-gradient(135deg, #F7931A, #e08a2e);
  --shadow-card: 0 8px 40px rgba(0,0,0,0.6);
  --radius: 12px;
  --radius-lg: 24px;
  --transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  --font-body: 'Inter', sans-serif;
  --font-mono: 'JetBrains Mono', monospace;
  --font-display: 'Sora', sans-serif;
}
* { margin:0; padding:0; box-sizing:border-box; }
html { scroll-behavior:smooth; -webkit-font-smoothing:antialiased; }
body { background:var(--bg-primary); color:var(--text-primary); font-family:var(--font-body); line-height:1.6; overflow-x:hidden; min-height:100vh; letter-spacing:-0.01em; }
::selection { background:var(--accent-gold); color:#0A0A0A; }
::-webkit-scrollbar { width:4px; }
::-webkit-scrollbar-track { background:var(--bg-primary); }
::-webkit-scrollbar-thumb { background:var(--accent-gold); border-radius:10px; }

#universe {
  position:fixed; inset:0; z-index:0;
  background: radial-gradient(ellipse at 20% 20%, rgba(247, 147, 26, 0.035), transparent 45%),
              radial-gradient(ellipse at 80% 80%, rgba(247, 147, 26, 0.035), transparent 45%),
              var(--bg-primary);
}

.container { max-width:1140px; margin:0 auto; padding:0 24px; position:relative; z-index:1; }
.section-padding { padding:60px 0 80px; }
@media(max-width:768px){ .section-padding { padding:44px 0 56px; } }

/* NAV */
.nav { position:fixed; top:0; left:0; right:0; z-index:1000; padding:14px 0; background:rgba(10,10,10,0.92); backdrop-filter:blur(20px); -webkit-backdrop-filter:blur(20px); border-bottom:1px solid rgba(255,255,255,0.04); }
.nav-inner { display:flex; align-items:center; justify-content:space-between; }
.nav-logo { display:flex; align-items:center; gap:10px; text-decoration:none; }
.nav-logo-icon { width:35px; height:32px; border-radius:5px; background:rgba(247,147,26,0.1); border:1px solid rgba(247,147,26,0.3); display:flex; align-items:center; justify-content:center; font-size:28px; font-weight:800; color:#F7931A; font-family:var(--font-display); }
.nav-logo-text { font-size:20px; font-weight:800; letter-spacing:-0.5px; font-family:var(--font-display); }
.nav-logo-text span { color:var(--accent-gold); }
.nav-back { color:var(--text-secondary); text-decoration:none; font-size:13px; font-family:var(--font-mono); display:flex; align-items:center; gap:6px; transition:var(--transition); }
.nav-back:hover { color:var(--accent-gold); }

/* HERO */
.svc-hero { padding:130px 0 20px; text-align:center; }
.sec-label { font-family:var(--font-mono); font-size:11px; font-weight:600; color:var(--accent-gold); letter-spacing:3px; text-transform:uppercase; margin-bottom:8px; }
.svc-title { font-family:var(--font-display); font-size:clamp(1.8rem,4vw,2.8rem); font-weight:800; letter-spacing:-0.5px; margin-bottom:14px; }
.svc-title .highlight { background:var(--gradient-gold); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text; }
.svc-sub { color:var(--text-secondary); font-size:1.05rem; max-width:620px; margin:0 auto; line-height:1.7; }

.intro-box { background:var(--bg-card); border:1px solid var(--accent-gold); border-radius:var(--radius-lg); padding:36px 40px; margin:36px 0; position:relative; overflow:hidden; }
.intro-box::before { content:'⚙️'; position:absolute; top:-50px; right:-50px; font-size:120px; opacity:0.04; }
.intro-box p { color:var(--text-secondary); font-size:15px; line-height:1.9; }
.intro-box p strong { color:var(--text-primary); }

.two-col { display:grid; grid-template-columns:1fr 1fr; gap:24px; margin-bottom:32px; }
@media(max-width:768px){ .two-col { grid-template-columns:1fr; } }
.col-card { background:var(--bg-card); border:1px solid var(--border-color); border-radius:var(--radius); padding:28px 24px; }
.col-card-title { font-size:20px; font-weight:700; font-family:var(--font-display); margin-bottom:20px; display:flex; align-items:center; gap:10px; }
.col-card ul { list-style:none; }
.col-card li { padding:10px 0; border-bottom:1px solid rgba(255,255,255,0.04); display:flex; align-items:flex-start; gap:12px; }
.col-card li:last-child { border-bottom:none; }
.col-card li .b1 { color:var(--accent-gold); font-size:18px; flex-shrink:0; }
.col-card li .b2 { color:var(--accent-cyan); font-size:16px; flex-shrink:0; }
.col-card li strong { color:#FFFFFF; }
.col-card li span.d { color:var(--text-secondary); font-size:14px; }

.sec-title { font-family:var(--font-display); font-size:clamp(1.5rem,2.6vw,2rem); font-weight:700; margin:12px 0 24px; }

.services-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:20px; }
@media(max-width:900px){ .services-grid { grid-template-columns:repeat(2,1fr); } }
@media(max-width:600px){ .services-grid { grid-template-columns:1fr; } }
.service-card { background:var(--bg-card); border:1px solid var(--border-color); border-radius:var(--radius); padding:24px 20px; text-align:center; transition:var(--transition); }
.service-card:hover { border-color:var(--accent-gold); transform:translateY(-4px); box-shadow:var(--shadow-card); }
.service-icon { font-size:32px; margin-bottom:12px; display:block; }
.service-title { font-size:15px; font-weight:700; font-family:var(--font-mono); margin-bottom:6px; }
.service-desc { font-size:13px; color:var(--text-secondary); line-height:1.6; }

.cta-box { background:linear-gradient(135deg, rgba(247,147,26,0.05), rgba(10,10,10,0.9)); border:1px solid rgba(247,147,26,0.10); border-radius:var(--radius-lg); padding:44px 40px; text-align:center; margin-top:40px; }
.cta-title { font-family:var(--font-display); font-size:1.5rem; font-weight:700; margin-bottom:10px; }
.cta-desc { color:var(--text-secondary); font-size:15px; margin-bottom:22px; }
.btn-primary { padding:14px 34px; border-radius:10px; background:var(--gradient-gold); color:#0A0A0A; font-weight:700; font-size:14px; border:none; cursor:pointer; text-decoration:none; display:inline-flex; align-items:center; gap:8px; font-family:var(--font-mono); }
.btn-primary:hover { transform:translateY(-3px); box-shadow:0 12px 32px rgba(247,147,26,0.35); }

.footer { padding:30px 0; border-top:1px solid var(--border-color); text-align:center; color:var(--text-muted); font-size:12px; }

/* MODAL (reuse) */
.modal { display:none; position:fixed; inset:0; z-index:2000; background:rgba(0,0,0,0.85); backdrop-filter:blur(16px); align-items:center; justify-content:center; padding:20px; }
.modal.open { display:flex; }
.modal-box { background:var(--bg-secondary); border:1px solid var(--border-color); border-radius:var(--radius-lg); max-width:420px; width:100%; padding:32px; position:relative; }
.modal-close { position:absolute; top:12px; right:16px; background:none; border:none; color:var(--text-muted); font-size:22px; cursor:pointer; }
.modal-close:hover { color:var(--text-primary); }
.modal-icon { width:56px; height:56px; border-radius:50%; background:var(--accent-gold-glow); border:1px solid rgba(247,147,26,0.2); display:flex; align-items:center; justify-content:center; font-size:24px; margin:0 auto 16px; }
.modal-title { font-size:20px; font-weight:700; text-align:center; margin-bottom:6px; font-family:var(--font-display); }
.modal-desc { color:var(--text-secondary); font-size:13.5px; text-align:center; margin-bottom:20px; line-height:1.7; }
.contact-list { display:flex; flex-direction:column; gap:10px; }
.contact-item { display:flex; align-items:center; gap:14px; padding:12px 16px; background:var(--bg-card); border:1px solid var(--border-color); border-radius:10px; text-decoration:none; transition:var(--transition); }
.contact-item:hover { border-color:var(--accent-gold); background:rgba(247,147,26,0.04); }
.contact-icon { width:36px; height:36px; border-radius:8px; display:flex; align-items:center; justify-content:center; font-size:15px; flex-shrink:0; }
.contact-icon.zalo { background:rgba(0,104,255,0.12); border:1px solid rgba(0,104,255,0.2); }
.contact-icon.telegram { background:rgba(34,211,238,0.12); border:1px solid rgba(34,211,238,0.2); }
.contact-icon.facebook { background:rgba(59,89,152,0.12); border:1px solid rgba(59,89,152,0.2); }
.contact-info { flex:1; }
.contact-label { font-weight:600; font-size:13px; font-family:var(--font-mono); }
.contact-value { font-size:11.5px; color:var(--text-muted); font-family:var(--font-mono); }
.contact-arrow { color:var(--text-muted); font-size:16px; }
</style>
</head>
